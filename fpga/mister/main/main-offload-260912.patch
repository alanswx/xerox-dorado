+// The caller retains its request when this returns false. In particular, do
+// not acknowledge or consume FPGA disk data until a worker slot is reserved.
+bool offload_try_add_work(std::function<void()> handler)
+{
+	PROFILE_FUNCTION();
+	if (!handler) return false;
+	pthread_mutex_lock(&s_queue_lock);
+	if (s_quit || (s_queue_head - s_queue_tail) == QUEUE_SIZE)
+	{
+		pthread_mutex_unlock(&s_queue_lock);
+		return false;
+	}
+	Work *work = &s_queue[s_queue_head % QUEUE_SIZE];
+	work->handler = std::move(handler);
+	s_queue_head++;
+	pthread_cond_signal(&s_cond_work);
+	pthread_mutex_unlock(&s_queue_lock);
+	return true;
+}
