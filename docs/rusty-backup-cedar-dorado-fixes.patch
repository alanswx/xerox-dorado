index a140491..86a1eeb 100644
--- a/src/fs/alto/pilot.rs
+++ b/src/fs/alto/pilot.rs
@@ -1563,62 +1563,149 @@ fn build_client_directory(entries: &[ClientDirEntry]) -> Result<Vec<u8>, Filesys
             .then(a.version.cmp(&b.version))
