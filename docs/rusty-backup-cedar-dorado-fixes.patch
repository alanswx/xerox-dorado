From f729640af045f064418066a49f814af26d2299d2 Mon Sep 17 00:00:00 2001
From: Alan Steremberg <alan.steremberg@gmail.com>
Date: Mon, 20 Jul 2026 20:19:25 -0400
Subject: [PATCH 4/5] rusty-backup: multi-page Cedar name directory +
 content-based filename recovery

build_client_directory could only write a single B-tree leaf (~1022 words,
~40 names) and errored otherwise, so a Cedar volume could name only a
handful of files. It now builds a proper 2-level B-tree -- a root internal
node whose minPage/grPage links point at the leaf pages, with the median
entries between leaves promoted into the root exactly once (per Cedar's
BTreeInternal.mesa). parse_client_directory already scavenger-walked all
pages, so it reads the result unchanged.

cedar_repack gains --names <dir>: it recovers a file's lost name by matching
the file's content (padded with zeros to a 512-byte page) against files
under <dir>. Cedar corpus volumes carry a file's bytes but often not its
name, and the bytes came from an archive of real files, so the match is
exact.

Verified end to end: a corpus repacked with both --names recovery and the
multi-page writer boots Cedar 6.1 and List enumerates 88 named files (up
from ~27), including names recovered only by content match, from a 2-level
directory. Unit test client_directory_spans_multiple_pages asserts 200
entries round-trip through a depth-2 tree with fp.da intact; full suite
2592 pass, clippy -D warnings clean.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 examples/cedar_repack.rs |  75 +++++++++++++-
 src/fs/alto/pilot.rs     | 207 +++++++++++++++++++++++++++++----------
 2 files changed, 226 insertions(+), 56 deletions(-)

diff --git a/examples/cedar_repack.rs b/examples/cedar_repack.rs
index 7c1f681..114d093 100644
--- a/examples/cedar_repack.rs
+++ b/examples/cedar_repack.rs
@@ -2,14 +2,68 @@
 //! a Cedar-valid volume while preserving as many user files and names as fit.
 //!
 //! Usage:
-//!   cedar_repack <old.pdi> <germ> <boot> <new.pdi> [max-files]
+//!   cedar_repack <old.pdi> <germ> <boot> <new.pdi> [max-files] [--names <dir>]
+//!
+//! `--names <dir>` recovers filenames by CONTENT: many Cedar corpus volumes
+//! carry a file's bytes but not its name (the historical writer named only a
+//! handful of headliners). If a copied file's content -- padded up to a page
+//! boundary -- matches a file under <dir>, that file's base name is used. The
+//! payload came from an archive of real files, so this is exact, not fuzzy.
 
+use std::collections::HashMap;
 use std::fs;
 
 use rusty_backup::fs::alto::pdi;
 use rusty_backup::fs::alto::pilot::{self, Generation, PilotFilesystem, PvBootFile};
 use rusty_backup::fs::filesystem::Filesystem;
 
+/// Index of <dir>'s files by exact byte length -> [(basename, content)]. A
+/// corpus file is the archive file padded with zeros to a 512-byte page, so a
+/// match is `corpus[..L] == archive` with an all-zero tail and `L` within one
+/// page of the corpus length.
+fn build_name_index(dir: &str) -> HashMap<usize, Vec<(String, Vec<u8>)>> {
+    let mut idx: HashMap<usize, Vec<(String, Vec<u8>)>> = HashMap::new();
+    let mut stack = vec![std::path::PathBuf::from(dir)];
+    while let Some(p) = stack.pop() {
+        let rd = match fs::read_dir(&p) {
+            Ok(r) => r,
+            Err(_) => continue,
+        };
+        for e in rd.flatten() {
+            let path = e.path();
+            if path.is_dir() {
+                stack.push(path);
+            } else if let Ok(b) = fs::read(&path) {
+                if b.is_empty() {
+                    continue;
+                }
+                let name = path.file_name().unwrap().to_string_lossy();
+                let base = name.split('!').next().unwrap_or(&name).to_string();
+                idx.entry(b.len()).or_default().push((base, b));
+            }
+        }
+    }
+    idx
+}
+
+/// Recover `data`'s name from the content index, or None.
+fn recover_name(data: &[u8], idx: &HashMap<usize, Vec<(String, Vec<u8>)>>) -> Option<String> {
+    let p = data.len();
+    for l in (p.saturating_sub(511)..=p).rev() {
+        if let Some(cands) = idx.get(&l) {
+            if data[l..].iter().any(|&b| b != 0) {
+                continue;
+            }
+            for (base, content) in cands {
+                if &data[..l] == content.as_slice() {
+                    return Some(base.clone());
+                }
+            }
+        }
+    }
+    None
+}
+
 const VOLUME_PAGES: u16 = 65535;
 
 fn is_old_boot_payload(name: &str) -> bool {
@@ -17,7 +71,20 @@ fn is_old_boot_payload(name: &str) -> bool {
 }
 
 fn main() {
-    let args: Vec<String> = std::env::args().skip(1).collect();
+    let mut args: Vec<String> = std::env::args().skip(1).collect();
+    let names_dir = args.iter().position(|a| a == "--names").map(|i| {
+        let d = args.get(i + 1).expect("--names needs a directory").clone();
+        args.drain(i..=i + 1);
