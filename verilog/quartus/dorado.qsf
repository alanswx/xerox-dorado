# Dorado on MiSTer -- a resource estimate for the DE10-Nano's Cyclone V.
#
# Device is the DE10-Nano part: 5CSEBA6U23I7 -- 41,910 ALMs, 5,570 Kbit M10K.
# Quartus Prime 17.0.2 Lite, which is what raetro/quartus:mister carries and
# what MiSTer cores are built with.
#
# NOTE: sources live in files.qip, not here. Quartus REWRITES this file on
# every build, so anything added directly is lost and the rewrite lands in
# `git status`. Run `git checkout -- dorado.qsf` after a build.
#
# NOTE: NUM_PARALLEL_PROCESSORS is deliberately NOT set. The image is
# linux/amd64 under emulation on Apple Silicon, where Quartus' parallel
# helpers crash and the parent deadlocks on their named pipes at ~4% CPU --
# a build that looks slow and never ends. tools/quartus-build.sh passes
# --parallel=1 to each stage instead.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY dorado_backplane
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
# The PROM cells $readmemh their images from repo-relative paths
# (verilog/proms/packages/*.mem) so that the Verilator benches can run from
# the repo root. Quartus resolves those relative to the PROJECT directory,
# so point it two levels up rather than duplicating the images.
set_global_assignment -name SEARCH_PATH ../..

set_global_assignment -name QIP_FILE files.qip
