DIRECTORYCommander USING [CommandProc, Register],ShowTime USING [GetMark,  ShowDelta, Microseconds],  -- all of the time measurement code isIO USING [Put, PutF, PutChar, string, card, NewLine, STREAM],Heap USING [CreateMDS, DeleteMDS],Inline USING [BITAND, BITXOR];IBenchMark: PROGRAM IMPORTS Commander, IO, ShowTime, Heap, Inline =BEGINz: MDSZone;            -- heap to use for packets and tasksin, out: IO.STREAM;    -- only "out" usedtracing: BOOLEAN;layout: CARDINAL;charsPerLine: CARDINAL = 50;Trace: PROCEDURE [ch: CHARACTER] = BEGINlayout _ layout-1;IF layout <= 0 THEN {out.NewLine[]; layout _ charsPerLine};out.PutChar[ch];END;InitTrace: PROCEDURE [] = {tracing _ FALSE; layout _ 0};TaskIdentity: TYPE = MACHINE DEPENDENT {idler(1), worker, handlerA, handlerB, deviceA, deviceB};Task: TYPE = POINTER TO TaskControlBlock;TaskControlBlock: TYPE = RECORD [link: Task,identity: TaskIdentity,priority: TaskPriority,input: WorkQueue,state: TaskState,function: TaskOperation,handle: UNSPECIFIED];TaskPriority: TYPE = CARDINAL;TaskState: TYPE =  RECORD [packetPending, taskWaiting, taskHolding: BOOLEAN _ FALSE];running: TaskState = [];waiting: TaskState = [taskWaiting: TRUE];waitingWithPacket: TaskState = [taskWaiting: TRUE, packetPending: TRUE];TaskOperation: TYPE = PROCEDURE [work: WorkQueue, word: UNSPECIFIED] RETURNS [t: Task];noTask: Task = NIL;WorkQueue: TYPE = POINTER TO Packet; Packet: TYPE = RECORD [link: WorkQueue,identity: TaskIdentity,kind: PacketKind,datum: UNSPECIFIED,data: ARRAY [0..packetBufferSize] OF UNSPECIFIED];    PacketKind: TYPE = {devicePacketKind, workPacketKind};packetBufferSize: CARDINAL = 3;noWork: WorkQueue = NIL;queuePacketCount, holdCount: CARDINAL;taskTable: ARRAY TaskIdentity OF Task;taskList: Task;currentTask: Task;currentTaskIdentity: TaskIdentity;InitScheduler: PROCEDURE [] = BEGINqueuePacketCount _ holdCount _ 0;taskTable _ ALL[noTask];taskList _ noTask;END;CreateTask: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, initialWorkQueue: WorkQueue, initialState: TaskState, function: TaskOperation, privateData: UNSPECIFIED] = BEGINt: Task _ z.NEW[TaskControlBlock _[link: taskList, identity: identity,priority: priority,input: initialWorkQueue, state: initialState, function: function,handle: privateData]];taskList _ t;taskTable[identity] _ t;END;CreatePacket: PROCEDURE [link: WorkQueue, identity: TaskIdentity, kind: PacketKind] RETURNS [workQueue: WorkQueue] = BEGINworkQueue _ z.NEW[Packet _[link: link, identity: identity, kind: kind, datum: 0, data: ALL[0]]];RETURN [workQueue];END;QueuePacket: PROCEDURE [packet: WorkQueue] RETURNS [task: Task] = INLINE BEGINt: Task _ FindTask[packet.identity];IF t=noTask THEN RETURN [noTask];queuePacketCount _ queuePacketCount+1;packet.link _ noWork;packet.identity _ currentTaskIdentity;  -- ???? DHCIF t.input=noWork THEN BEGINt.input _ packet;t.state.packetPending _ TRUE;IF t.priority > currentTask.priority THEN RETURN [t]END ELSE Append[packet, @t.input];RETURN [currentTask];END;Append: PROCEDURE [packet: WorkQueue, head: POINTER TO WorkQueue] = INLINE BEGINpacket.link _ noWork;IF head^=noWork THEN {head^ _ packet; RETURN};FOR mouse: WorkQueue _ head^, mouse.link UNTIL mouse.link=noWork DOREPEATFINISHED => mouse.link _ packetENDLOOP;END;Schedule: PROCEDURE = BEGINmessage: WorkQueue;currentTask _ taskList;WHILE currentTask#noTask DOmessage _ noWork;IF currentTask.state.taskHolding OR currentTask.state=waiting THEN currentTask _ currentTask.link ELSE BEGINIF currentTask.state=waitingWithPacket THEN BEGINmessage _ currentTask.input;currentTask.input _ message.link;IF currentTask.input=noWork THEN currentTask.state _ runningELSE currentTask.state _ [packetPending: TRUE]END;currentTaskIdentity _ currentTask.identity;IF tracing THEN Trace[LOOPHOLE[currentTaskIdentity, CARDINAL]+'0];currentTask _ currentTask.function[message, currentTask.handle];END;ENDLOOP;END;Wait: PROCEDURE [] RETURNS [task: Task] = INLINE BEGINcurrentTask.state.taskWaiting _ TRUE;RETURN [currentTask];END;HoldSelf: PROCEDURE [] RETURNS [task: Task] = INLINE BEGINholdCount _ holdCount+1;currentTask.state.taskHolding _ TRUE;RETURN [currentTask.link];END;Release: PROCEDURE [identity: TaskIdentity] RETURNS [task: Task] = INLINE BEGINt: Task _ FindTask[identity];IF t=noTask THEN RETURN [noTask];t.state.taskHolding _ FALSE;IF t.priority > currentTask.priority THEN RETURN [t]ELSE RETURN [currentTask];END;FindTask: PROCEDURE [identity: TaskIdentity] RETURNS [task: Task] = INLINE BEGINt: Task _ taskTable[identity];IF t=noTask THEN ERROR;RETURN [t];END;hashValue: CARDINAL =  --0D008X-- 150010B;  -- MOAN!!!!!IdleTaskDataRecord: TYPE = RECORD [control: WORD, count: CARDINAL];IdleTaskData: TYPE = POINTER TO IdleTaskDataRecord;initialControl: WORD = 1;CreateIdler: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, work: WorkQueue, state: TaskState] = BEGINdata: IdleTaskData _ z.NEW[IdleTaskDataRecord _ [initialControl, 10000]];CreateTask[identity, priority, work, state, IdleFunction, data];END;IdleFunction: TaskOperation = BEGINdata: IdleTaskData _ word;data.count _ data.count-1;IF data.count=0 THEN RETURN [HoldSelf[]];IF Inline.BITAND[data.control, 1]=0 THEN {data.control _ data.control/2;RETURN [Release[deviceA]];} ELSE {data.control _ Inline.BITXOR[data.control/2, hashValue]; RETURN [Release[deviceB]]};END;DeviceTaskDataRecord: TYPE = RECORD [pending: WorkQueue];DeviceTaskData: TYPE = POINTER TO DeviceTaskDataRecord;CreateDevice: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, work: WorkQueue, state: TaskState] =BEGINdata: DeviceTaskData _ z.NEW[DeviceTaskDataRecord _ [noWork]];CreateTask[identity, priority, work, state, DeviceFunction, data];END;DeviceFunction: TaskOperation = BEGINdata: DeviceTaskData _ word;IF work=noWork THEN BEGINIF data.pending=noWork THEN RETURN [Wait[]];work _ data.pending;data.pending _ noWork;RETURN [QueuePacket[work]]END ELSE BEGINdata.pending _ work;IF tracing THEN Trace[work.datum];RETURN [HoldSelf[]]END;END;HandlerTaskDataRecord: TYPE = RECORD [workIn, deviceIn: WorkQueue];HandlerTaskData: TYPE = POINTER TO HandlerTaskDataRecord;CreateHandler: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, work: WorkQueue, state: TaskState] = BEGINdata: HandlerTaskData _ z.NEW[HandlerTaskDataRecord _ [noWork, noWork]];CreateTask[identity, priority, work, state, HandlerFunction, data];END;HandlerFunction: TaskOperation = BEGINdata: HandlerTaskData _ word;workPacket, devicePacket: WorkQueue;count: INTEGER;IF work#noWork THEN {IF work.kind=workPacketKind THEN Append[work, @data.workIn]ELSE Append[work, @data.deviceIn];};IF data.workIn#noWork THEN BEGINworkPacket _ data.workIn;count _ workPacket.datum;IF count > packetBufferSize THEN {data.workIn _ data.workIn.link;RETURN [QueuePacket[workPacket]];};IF data.deviceIn#noWork THEN BEGINdevicePacket _ data.deviceIn;data.deviceIn _ data.deviceIn.link;devicePacket.datum _ workPacket.data[count];workPacket.datum _ count+1;RETURN [QueuePacket[devicePacket]]END;END;RETURN [Wait[]];END;WorkerTaskDataRecord: TYPE = RECORD [destination: TaskIdentity, count: CARDINAL];WorkerTaskData: TYPE = POINTER TO WorkerTaskDataRecord;CreateWorker: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, work: WorkQueue, state: TaskState] = BEGINdata: WorkerTaskData _ z.NEW[WorkerTaskDataRecord _ [handlerA, 0]];CreateTask[identity, priority, work, state, WorkFunction, data];END;WorkFunction: TaskOperation = BEGINdata: WorkerTaskData _ word;IF work=noWork THEN RETURN [Wait[]]ELSE BEGINdata.destination _ (IF data.destination=handlerA THEN handlerB ELSE handlerA);work.identity _ data.destination;work.datum _ 0;FOR i: CARDINAL IN [0..packetBufferSize] DOdata.count _ data.count+1;IF data.count > 26 THEN data.count _ 1;work.data[i] _ 'A+data.count-1;ENDLOOP;RETURN [QueuePacket[work]];END;END;Main: Commander.CommandProc = TRUSTED BEGINworkQ: WorkQueue;mark1, mark2, mark3, mark4: ShowTime.Microseconds; -- for benchmark timingPutDigit: SAFE PROCEDURE [c: CHAR] RETURNS [BOOL] = TRUSTED BEGINout.PutChar[c];RETURN [FALSE];END;mark1 _ ShowTime.GetMark[];z _ Heap.CreateMDS[initial: 2];in _ cmd.in;out _ cmd.out;out.Put[IO.string["Bench mark starting\n"]];InitTrace[];InitScheduler[];CreateIdler[idler, 0, noWork, running];workQ _ CreatePacket[noWork, worker, workPacketKind];workQ _ CreatePacket[workQ, worker, workPacketKind];CreateWorker[worker, 1000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];CreateHandler[handlerA, 2000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];CreateHandler[handlerB, 3000, workQ, waitingWithPacket];CreateDevice[deviceA, 4000, noWork, waiting];CreateDevice[deviceB, 5000, noWork, waiting];out.Put[IO.string["Starting\n"]];mark2 _ ShowTime.GetMark[];Schedule[];mark3 _ ShowTime.GetMark[];out.Put[IO.string["Finished\n"]];out.PutF["QueuePacket count = %g, HoldCount = %g\nThese results are ", IO.card[queuePacketCount], IO.card[holdCount]];IF (queuePacketCount = 23246) AND (holdCount = 9297) THEN out.Put[IO.string["correct"]]ELSE out.Put[IO.string["wrong"]];out.Put[IO.string["\nEnd of run\n"]];mark4 _ ShowTime.GetMark[];out.Put[IO.string["***** Scheduler time = "]];ShowTime.ShowDelta[mark3 - mark2, PutDigit];out.Put[IO.string[", Total time = "]];ShowTime.ShowDelta[mark4 - mark1, PutDigit];Heap.DeleteMDS[z];END;Commander.Register["IBenchMark", Main];END... ␀␀0␀␀IBenchMark.mesa (originally fr