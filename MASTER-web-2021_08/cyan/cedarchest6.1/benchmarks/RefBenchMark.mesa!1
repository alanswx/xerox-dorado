DIRECTORYShowTime USING [GetMark,  ShowDelta, Microseconds],  -- all of the time measurement code is														  --  commented out when measuring code sizeUserExec USING [RegisterCommand, CommandProc, GetStreams],IO USING [Put, PutF, PutChar, string, card, NewLine, STREAM],Inline USING [BITAND, BITXOR];RefBenchmark: PROGRAM IMPORTS UserExec, IO, ShowTime, Inline =BEGINin, out: IO.STREAM;    -- only "out" usedcharsPerLine: CARDINAL = 50;tracing: BOOLEAN;layout: CARDINAL;Trace: PROC [ch: CHARACTER] =BEGINlayout _ layout-1;IF layout <= 0THEN {out.NewLine[]; layout _ charsPerLine};out.PutChar[ch];END;InitTrace: PROC = {tracing _ FALSE; layout _ 0};TaskIdentity: TYPE = MACHINE DEPENDENT{idler(1), worker, handlerA, handlerB, deviceA, deviceB};WorkQueue: TYPE = --Cedar--REF Packet; Task: TYPE = --Cedar--REF TaskControlBlock;TaskPriority: TYPE = CARDINAL;TaskState: TYPE = RECORD [packetPending, taskWaiting, taskHolding: BOOLEAN _ FALSE];running: TaskState = [];waiting: TaskState = [taskWaiting: TRUE];waitingWithPacket: TaskState = [taskWaiting: TRUE, packetPending: TRUE];TaskOperation: TYPE = PROC [work: WorkQueue, taskArg: --Cedar--REF] RETURNS [t: Task];TaskControlBlock: TYPE = RECORD[link: Task,identity: TaskIdentity,priority: TaskPriority,input: WorkQueue,state: TaskState,function: TaskOperation,handle: --Cedar--REF ];noTask: Task = NIL;PacketKind: TYPE = {devicePacketKind, workPacketKind};packetBufferSize: CARDINAL = 3;Packet: TYPE = RECORD[link: WorkQueue,identity: TaskIdentity,kind: PacketKind,datum: UNSPECIFIED,data: ARRAY [0..packetBufferSize] OF UNSPECIFIED];    noWork: WorkQueue = NIL;queuePacketCount, holdCount: CARDINAL;taskTable: ARRAY TaskIdentity OF Task;taskList: Task;currentTask: Task;currentTaskIdentity: TaskIdentity;CreateTask: PROC [identity: TaskIdentity, priority: TaskPriority, initialWorkQueue: WorkQueue, initialState: TaskState,function: TaskOperation, privateData: --Cedar--REF] =BEGINt: Task _ NEW[TaskControlBlock _[link: taskList, identity: identity,priority: priority,input: initialWorkQueue, state: initialState, function: function,handle: privateData]];taskList _ t;taskTable[identity] _ t;END;CreatePacket: PROC [link: WorkQueue, identity: TaskIdentity, kind: PacketKind]RETURNS [p: WorkQueue] =BEGINp _ NEW[Packet _[link: link, identity: identity, kind: kind, datum: 0, data: ALL[0]]];END;QueuePacket: PROC [packet: WorkQueue] RETURNS [t: Task] =BEGINIF (t _ FindTask[packet.identity])=noTask THEN RETURN;queuePacketCount _ queuePacketCount+1;packet.link _ noWork;packet.identity _ currentTaskIdentity;  -- ???? DHCIF t.input=noWorkTHEN {t.input _ packet;t.state.packetPending _ TRUE;IF t.priority > currentTask.priority THEN RETURN}ELSEt.input _ Append[packet, t.input];RETURN [currentTask];END;Append: PROC [packet: WorkQueue, head: WorkQueue] RETURNS[newHead: WorkQueue] =BEGIN --Cedarpacket.link _ noWork;IF head=noWork THEN RETURN[packet];	--CedarFOR mouse: WorkQueue _ head, mouse.link WHILE mouse.link#noWork DOREPEATFINISHED => {mouse.link _ packet; RETURN[head]};ENDLOOP;END;Schedule: PROC =BEGINmessage: WorkQueue;currentTask _ taskList;WHILE currentTask#noTask DOmessage _ noWork;IF currentTask.state.taskHolding OR currentTask.state=waitingTHENcurrentTask _ currentTask.linkELSE {IF currentTask.state=waitingWithPacketTHEN {message _ currentTask.input;currentTask.input _ message.link;currentTask.state _ IF currentTask.input=noWorkTHEN running ELSE [packetPending: TRUE]}; currentTaskIdentity _ currentTask.identity;IF tracing THENTrace[LOOPHOLE[currentTaskIdentity, CARDINAL]+'0];currentTask _ currentTask.function[message, currentTask.handle]};ENDLOOP;END;Wait: PROC [] RETURNS [Task] = {currentTask.state.taskWaiting _ TRUE;RETURN [currentTask]};HoldSelf: PROC [] RETURNS [Task] = {holdCount _ holdCount+1;currentTask.state.taskHolding _ TRUE;RETURN [currentTask.link]};Release: PROC [identity: TaskIdentity] RETURNS [t: Task] = {t _ FindTask[identity];IF t=noTask THEN RETURN;t.state.taskHolding _ FALSE;RETURN[IF t.priority > currentTask.priority THEN t ELSE currentTask]}; FindTask: PROC [identity: TaskIdentity] RETURNS [t: Task] =  {IF (t _ taskTable[identity])=noTask THEN ERROR};InitScheduler: PROC = {queuePacketCount _ holdCount _ 0;taskTable _ ALL[noTask];taskList _ noTask};initialControl: WORD = 1;hashValue: CARDINAL =  --0D008X-- 150010B;  -- MOAN!!!!!IdleTaskDataRecord: TYPE = RECORD [control: WORD, count: CARDINAL];IdleTaskData: TYPE = --Cedar--REF IdleTaskDataRecord;CreateIdler: PROC [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: IdleTaskData _ NEW[IdleTaskDataRecord _ [initialControl, 10000]];CreateTask[identity, priority, work, state, IdleFunction, data];END;IdleFunction: TaskOperation =BEGINdata: IdleTaskData _ NARROW[taskArg];data.count _ data.count-1;IF data.count=0 THEN RETURN [HoldSelf[]];IF Inline.BITAND[data.control, 1]=0 THEN {data.control _ data.control/2;  RETURN [Release[deviceA]]}ELSE {data.control _ Inline.BITXOR[data.control/2, hashValue]; RETURN [Release[deviceB]]};END;InitIdle: PROC = {  --TBD}; DeviceTaskData: TYPE = --Cedar--REF DeviceTaskDataRecord;DeviceTaskDataRecord: TYPE = RECORD [pending: WorkQueue];CreateDevice: PROC [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] = {data: DeviceTaskData _ NEW[DeviceTaskDataRecord _ [pending: noWork]];CreateTask[identity, priority, work, state, DeviceFunction, data]};DeviceFunction: TaskOperation =BEGINdata: DeviceTaskData = NARROW[taskArg];IF work=noWork THEN {IF data.pending=noWork THEN RETURN [Wait[]];work _ data.pending;data.pending _ noWork;RETURN [QueuePacket[work]]}ELSE {data.pending _ work;IF tracing THEN Trace[work.datum];RETURN [HoldSelf[]]};END;HandlerTaskData: TYPE = --Cedar--REF HandlerTaskDataRecord;HandlerTaskDataRecord: TYPE = RECORD [workIn, deviceIn: WorkQueue];CreateHandler: PROC [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: HandlerTaskData _ NEW[HandlerTaskDataRecord _ [noWork, noWork]];CreateTask[identity, priority, work, state, HandlerFunction, data];END;HandlerFunction: TaskOperation =BEGINdata: HandlerTaskData = NARROW[taskArg];workPacket, devicePacket: WorkQueue;count: INTEGER;IF work#noWorkTHEN IF work.kind=workPacketKind THEN data.workIn_Append[work, data.workIn]ELSE data.deviceIn_Append[work, data.deviceIn];IF data.workIn#noWorkTHENBEGINworkPacket _ data.workIn;count _ workPacket.datum;IF count > packetBufferSizeTHEN {data.workIn _ data.workIn.link;  RETURN [QueuePacket[workPacket]]};IF data.deviceIn#noWorkTHENBEGINdevicePacket _ data.deviceIn;data.deviceIn _ data.deviceIn.link;devicePacket.datum _ workPacket.data[count];workPacket.datum _ count+1;RETURN [QueuePacket[devicePacket]]END;END;RETURN [Wait[]];END;WorkerTaskData: TYPE = --Cedar--REF WorkerTaskDataRecord;WorkerTaskDataRecord: TYPE = RECORD [destination: TaskIdentity, count: CARDINAL];CreateWorker: PROC [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: WorkerTaskData _ NEW[WorkerTaskDataRecord _ [destination: handlerA, count: 0]];CreateTask[identity, priority, work, state, WorkFunction, data];END;WorkFunction: TaskOperation =BEGINdata: WorkerTaskData _ NARROW[taskArg];IF work=noWork  THEN RETURN [Wait[]]ELSE {data.destination _ (IF data.destination#handlerA THEN handlerA ELSE handlerB);work.identity _ data.destination;work.datum _ 0;FOR i: CARDINAL IN [0..packetBufferSize] DOdata.count _ data.count+1;IF data.count > 26 THEN data.count _ 1;work.data[i] _ 'A+data.count-1;ENDLOOP;RETURN [QueuePacket[work]]};END;Main: UserExec.CommandProc = TRUSTEDBEGINworkQ: WorkQueue;mark1, mark2, mark3, mark4: ShowTime.Microseconds; -- for benchmark timingPutDigit: SAFE PROC [c: CHAR] RETURNS [BOOL] = TRUSTEDBEGIN out.PutChar[c]; RETURN [FALSE]; END;mark1 _ ShowTime.GetMark[];[in, out] _ UserExec.GetStreams[exec];  -- exec is an ExecHandle, a parameter to Mainout.Put[IO.string["Bench mark starting\n"]];InitTrace[];InitScheduler[];CreateIdler[idler, 0, noWork, running];workQ _ CreatePacket[noWork, worker, workPacketKind];workQ _ CreatePacket[workQ, worker, workPacketKind];CreateWorker[worker, 1000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];CreateHandler[handlerA, 2000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];CreateHandler[handlerB, 3000, workQ, waitingWithPacket];CreateDevice[deviceA, 4000, noWork, waiting];CreateDevice[deviceB, 5000, noWork, waiting];out.Put[IO.string["Starting\n"]];mark2 _ ShowTime.GetMark[];Schedule[];mark3 _ ShowTime.GetMark[];out.Put[IO.string["Finished\n"]];out.PutF["QueuePacket count = %g, HoldCount = %g\nThese results are ", IO.card[queuePacketCount], IO.card[holdCount]];IF (queuePacketCount = 23246) AND (holdCount = 9297) THEN out.Put[IO.string["correct"]]ELSE out.Put[IO.string["wrong"]];out.Put[IO.string["\nEnd of run\n"]];mark4 _ ShowTime.GetMark[];out.Put[IO.string["***** Scheduler time = "]];ShowTime.ShowDelta[mark3 - mark2, PutDigit];out.Put[IO.string[", Total time = "]];ShowTime.ShowDelta[mark4 - mark1, PutDigit];END;UserExec.RegisterCommand["RefBenchMark", Main];END... ␀␀␀\␀␀RefBenchMark.mesa (originally from University of Cambridge)Last Edited by: DCraft, September 13, 1983 12:45 pmMARTIN RICHARDS' BENCHMARK PROGRAM transcribed from BCPLvia Modula version by Peter Robinson of Fri May 20 14:55:00 1983via Mes