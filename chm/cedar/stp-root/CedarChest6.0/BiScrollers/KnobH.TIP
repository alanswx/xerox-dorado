SELECT TRIGGER FROM  Red Down => Coords, Decrease, Idle;  Yellow Down WHILE LeftShift Down => Coords, Reset, Idle;  Yellow Down => Coords, Random, Idle;  Blue Down => Coords, Increase, Idle;  Mouse => SELECT ENABLE FROM  	Red Down => Coords, Decrease, Idle;  	Yellow Down => SELECT ENABLE FROM  		LeftShift Down => Coords, Reset, Idle;  		ENDCASE => Coords, Random, Idle;  	Blue Down => Coords, Increase, Idle;  	ENDCASE => Coords;  Red Up => Coords, Decrease, Doit;  Yellow Up WHILE LeftShift Down => Coords, Reset, Doit;  Yellow Up => Coords, Random, Doit;  Blue Up => Coords, Increase, Doit;  ENDCASE.