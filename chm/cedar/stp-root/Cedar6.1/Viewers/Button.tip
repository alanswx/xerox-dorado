-- Button.tip; edited by McGregor, September 9, 1982 1:55 pmSELECT TRIGGER FROM  Red Down => Coords, Mark;  Mouse WHILE Red Down => Coords, Mark;  Red Up => SELECT ENABLE FROM    LeftShift Down		=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Red, Hit;      ENDCASE			=> Shift, Red, Hit;    RightShift Down	=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Red, Hit;      ENDCASE			=> Shift, Red, Hit;    Ctrl Down			=> Control, Red, Hit;    ENDCASE			=> Red, Hit;  Yellow Down => Coords, Mark;  Mouse WHILE Yellow Down => Coords, Mark;  Yellow Up => SELECT ENABLE FROM    LeftShift Down		=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Yellow, Hit;      ENDCASE			=> Shift, Yellow, Hit;    RightShift Down	=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Yellow, Hit;      ENDCASE			=> Shift, Yellow, Hit;    Ctrl Down			=> Control, Yellow, Hit;    ENDCASE			=> Yellow, Hit;  Blue Down => Coords, Mark;  Mouse WHILE Blue Down => Coords, Mark;  Blue Up => SELECT ENABLE FROM    LeftShift Down		=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Blue, Hit;      ENDCASE			=> Shift, Blue, Hit;    RightShift Down	=> SELECT ENABLE FROM      Ctrl Down			=> Control, Shift, Blue, Hit;      ENDCASE			=> Shift, Blue, Hit;    Ctrl Down			=> Control, Blue, Hit;    ENDCASE			=> Blue, Hit;  ENDCASE.