-- ViewerAdjust.tip; Last Edited by McGregor, September 14, 1982 9:05 am-- Last Edited by: Maxwell, May 20, 1983 8:01 amSELECT TRIGGER FROM  Mouse => Coords, Move;  Red Up => Coords, End;  Red Down => SELECT ENABLE FROM  	Blue Down => Abort;  	Yellow Down => Abort;  	ENDCASE;  Yellow Up => Coords, End;  Yellow Down => SELECT ENABLE FROM  	Blue Down => Abort;  	Red Down => Abort;  	ENDCASE;  Blue Up => Coords, End;  Blue Down => SELECT ENABLE FROM  	Red Down => Abort;  	Yellow Down => Abort;  	ENDCASE;    ENDCASE.