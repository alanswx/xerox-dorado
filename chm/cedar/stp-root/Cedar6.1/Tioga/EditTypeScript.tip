-- EditTypeScript.tip; Last Edited by Paxton, November 8, 1982 10:30 amOPTIONS  Fast;[DEF,CTRL,(Ctrl Down | Spare3 Down)][DEF,IfCaretAtEnd,(~1 Down WHILE CaretAtEndOfTypescript => Char)][DEF,IfCtrlAndCaretAtEnd,(~1 Down WHILE [CTRL] WHILE CaretAtEndOfTypescript => Char)][DEF,CtrlAndCaretAtEnd,(Down WHILE [CTRL] WHILE CaretAtEndOfTypescript)]SELECT TRIGGER FROM  [IfCaretAtEnd,ESC];  [IfCaretAtEnd,LF];  [IfCaretAtEnd,Return];  [IfCtrlAndCaretAtEnd,C];  [IfCtrlAndCaretAtEnd,Q];  [IfCtrlAndCaretAtEnd,O];  [IfCtrlAndCaretAtEnd,R];  [IfCtrlAndCaretAtEnd,T];  [IfCtrlAndCaretAtEnd,X];  [IfCtrlAndCaretAtEnd,Z];    DEL [CtrlAndCaretAtEnd] => Abort;  A [CtrlAndCaretAtEnd] => BackSpace;  H [CtrlAndCaretAtEnd] => BackSpace;  W [CtrlAndCaretAtEnd] => BackWord;    ENDCASE....