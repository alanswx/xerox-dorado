% BasicLooks.Style% last edited by Paxton, April 13, 1982 12:53 pmBeginStyle(bp) "big point" {72.0 .div in} StyleRule(look.b) "add bold to font face" {+bold face} StyleRule(look.i) "add italic to font face" {+italic face} StyleRule(look.l) "larger font" {12 bp size "TimesRoman" family} StyleRule(look.m) "much larger" {18 bp size "TimesRoman" family} StyleRule(look.s) "smaller font" {8 bp size "TimesRoman" family} StyleRule(look.u) "underline all characters" {all underlined} StyleRuleEndStyle