DIRECTORYShowTime USING [GetMark,  ShowDelta, Microseconds],  -- all of the time measurement code is														  --  commented out when measuring code sizeUserExec USING [RegisterCommand, CommandProc, GetStreams],IO USING [Put, PutF, PutChar, string, card, NewLine, STREAM],Heap USING [CreateMDS, DeleteMDS],Inline USING [BITAND, BITXOR];Benchmark:PROGRAM IMPORTS UserExec, IO, ShowTime, Heap, Inline =BEGINz: MDSZone;            -- heap to use for packets and tasksin, out: IO.STREAM;    -- only "out" usedtracing: BOOLEAN;layout: CARDINAL;charsPerLine: CARDINAL = 50;Trace: PROCEDURE [ch: CHARACTER] =BEGINlayout _ layout-1;IF layout <= 0THEN {out.NewLine[]; layout _ charsPerLine};out.PutChar[ch];END;InitTrace: PROCEDURE [] = {tracing _ FALSE; layout _ 0};TaskIdentity: TYPE = MACHINE DEPENDENT{idler(1), worker, handlerA, handlerB, deviceA, deviceB};Task: TYPE = POINTER TO TaskControlBlock;TaskControlBlock: TYPE = RECORD[link: Task,identity: TaskIdentity,priority: TaskPriority,input: WorkQueue,state: TaskState,function: TaskOperation,handle: UNSPECIFIED];TaskPriority: TYPE = CARDINAL;TaskState: TYPE = RECORD [packetPending, taskWaiting, taskHolding: BOOLEAN _ FALSE];running: TaskState = [];waiting: TaskState = [taskWaiting: TRUE];waitingWithPacket: TaskState = [taskWaiting: TRUE, packetPending: TRUE];TaskOperation: TYPE = PROCEDURE [work: WorkQueue, word: UNSPECIFIED] RETURNS [t: Task];noTask: Task = NIL;WorkQueue: TYPE = POINTER TO Packet; Packet: TYPE = RECORD[link: WorkQueue,identity: TaskIdentity,kind: PacketKind,datum: UNSPECIFIED,data: ARRAY [0..packetBufferSize] OF UNSPECIFIED];    PacketKind: TYPE = {devicePacketKind, workPacketKind};packetBufferSize: CARDINAL = 3;noWork: WorkQueue = NIL;queuePacketCount, holdCount: CARDINAL;taskTable: ARRAY TaskIdentity OF Task;taskList: Task;currentTask: Task;currentTaskIdentity: TaskIdentity;InitScheduler: PROCEDURE [] =BEGINqueuePacketCount _ holdCount _ 0;taskTable _ ALL[noTask];taskList _ noTask;END;CreateTask: PROCEDURE [identity: TaskIdentity, priority: TaskPriority, initialWorkQueue: WorkQueue, initialState: TaskState,function: TaskOperation, privateData: UNSPECIFIED] =BEGINt: Task _ z.NEW[TaskControlBlock _[link: taskList, identity: identity,priority: priority,input: initialWorkQueue, state: initialState, function: function,handle: privateData]];taskList _ t;taskTable[identity] _ t;END;CreatePacket: PROCEDURE [link: WorkQueue, identity: TaskIdentity, kind: PacketKind]RETURNS [workQueue: WorkQueue] =BEGINworkQueue _ z.NEW[Packet _[link: link, identity: identity, kind: kind, datum: 0, data: ALL[0]]];RETURN [workQueue];END;QueuePacket: PROCEDURE [packet: WorkQueue] RETURNS [task: Task] =BEGINt: Task _ FindTask[packet.identity];IF t=noTask THEN RETURN [noTask];queuePacketCount _ queuePacketCount+1;packet.link _ noWork;packet.identity _ currentTaskIdentity;  -- ???? DHCIF t.input=noWorkTHENBEGINt.input _ packet;t.state.packetPending _ TRUE;IF t.priority > currentTask.priority THEN RETURN [t]ENDELSEAppend[packet, @t.input];RETURN [currentTask];END;Append: PROCEDURE [packet: WorkQueue, head: POINTER TO WorkQueue] =BEGINpacket.link _ noWork;IF head^=noWork THEN {head^ _ packet; RETURN};FOR mouse: WorkQueue _ head^, mouse.link UNTIL mouse.link=noWorkDOREPEATFINISHED => mouse.link _ packetENDLOOP;END;Schedule: PROCEDURE =BEGINmessage: WorkQueue;currentTask _ taskList;WHILE currentTask#noTaskDOmessage _ noWork;IF currentTask.state.taskHolding OR currentTask.state=waitingTHENcurrentTask _ currentTask.linkELSEBEGINIF currentTask.state=waitingWithPacketTHENBEGINmessage _ currentTask.input;currentTask.input _ message.link;IF currentTask.input=noWork THEN currentTask.state _ runningELSE currentTask.state _ [packetPending: TRUE]END;currentTaskIdentity _ currentTask.identity;IF tracingTHEN Trace[LOOPHOLE[currentTaskIdentity, CARDINAL]+'0];currentTask _ currentTask.function[message, currentTask.handle];END;ENDLOOP;END;Wait: PROCEDURE [] RETURNS [task: Task] =BEGINcurrentTask.state.taskWaiting _ TRUE;RETURN [currentTask];END;HoldSelf: PROCEDURE [] RETURNS [task: Task] =BEGINholdCount _ holdCount+1;currentTask.state.taskHolding _ TRUE;RETURN [currentTask.link];END;Release: PROCEDURE [identity: TaskIdentity] RETURNS [task: Task] =BEGINt: Task _ FindTask[identity];IF t=noTask THEN RETURN [noTask];t.state.taskHolding _ FALSE;IF t.priority > currentTask.priority THEN RETURN [t]ELSE RETURN [currentTask];END;FindTask: PROCEDURE [identity: TaskIdentity] RETURNS [task: Task] =BEGINt: Task _ taskTable[identity];IF t=noTask THEN ERROR;RETURN [t];END;hashValue: CARDINAL =  --0D008X-- 150010B;  -- MOAN!!!!!IdleTaskDataRecord: TYPE = RECORD [control: WORD, count: CARDINAL];IdleTaskData: TYPE = POINTER TO IdleTaskDataRecord;initialControl: WORD = 1;CreateIdler: PROCEDURE [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: IdleTaskData _ z.NEW[IdleTaskDataRecord _ [initialControl, 10000]];CreateTask[identity, priority, work, state, IdleFunction, data];END;IdleFunction: TaskOperation =BEGINdata: IdleTaskData _ word;data.count _ data.count-1;IF data.count=0 THEN RETURN [HoldSelf[]];IF Inline.BITAND[data.control, 1]=0THEN {data.control _ data.control/2;  RETURN [Release[deviceA]]}ELSE {data.control _ Inline.BITXOR[data.control/2, hashValue]; RETURN [Release[deviceB]]};END;DeviceTaskDataRecord: TYPE = RECORD [pending: WorkQueue];DeviceTaskData: TYPE = POINTER TO DeviceTaskDataRecord;CreateDevice: PROCEDURE [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: DeviceTaskData _ z.NEW[DeviceTaskDataRecord _ [noWork]];CreateTask[identity, priority, work, state, DeviceFunction, data];END;DeviceFunction: TaskOperation =BEGINdata: DeviceTaskData _ word;IF work=noWork THENBEGINIF data.pending=noWork THEN RETURN [Wait[]];work _ data.pending;data.pending _ noWork;RETURN [QueuePacket[work]]ENDELSEBEGINdata.pending _ work;IF tracing THEN Trace[work.datum];RETURN [HoldSelf[]]END;END;HandlerTaskDataRecord: TYPE = RECORD [workIn, deviceIn: WorkQueue];HandlerTaskData: TYPE = POINTER TO HandlerTaskDataRecord;CreateHandler: PROCEDURE [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: HandlerTaskData _ z.NEW[HandlerTaskDataRecord _ [noWork, noWork]];CreateTask[identity, priority, work, state, HandlerFunction, data];END;HandlerFunction: TaskOperation =BEGINdata: HandlerTaskData _ word;workPacket, devicePacket: WorkQueue;count: INTEGER;IF work#noWorkTHEN IF work.kind=workPacketKind THEN Append[work, @data.workIn]ELSE Append[work, @data.deviceIn];IF data.workIn#noWorkTHENBEGINworkPacket _ data.workIn;count _ workPacket.datum;IF count > packetBufferSizeTHEN {data.workIn _ data.workIn.link;  RETURN [QueuePacket[workPacket]]};IF data.deviceIn#noWorkTHENBEGINdevicePacket _ data.deviceIn;data.deviceIn _ data.deviceIn.link;devicePacket.datum _ workPacket.data[count];workPacket.datum _ count+1;RETURN [QueuePacket[devicePacket]]END;END;RETURN [Wait[]];END;WorkerTaskDataRecord: TYPE = RECORD [destination: TaskIdentity, count: CARDINAL];WorkerTaskData: TYPE = POINTER TO WorkerTaskDataRecord;CreateWorker: PROCEDURE [identity: TaskIdentity, priority: TaskPriority,work: WorkQueue, state: TaskState] =BEGINdata: WorkerTaskData _ z.NEW[WorkerTaskDataRecord _ [handlerA, 0]];CreateTask[identity, priority, work, state, WorkFunction, data];END;WorkFunction: TaskOperation =BEGINdata: WorkerTaskData _ word;IF work=noWorkTHEN RETURN [Wait[]]ELSEBEGINdata.destination _ (IF data.destination=handlerA THEN handlerB ELSE handlerA);work.identity _ data.destination;work.datum _ 0;FOR i: CARDINAL IN [0..packetBufferSize] DOdata.count _ data.count+1;IF data.count > 26 THEN data.count _ 1;work.data[i] _ 'A+data.count-1;ENDLOOP;RETURN [QueuePacket[work]];END;END;Main: UserExec.CommandProc = TRUSTEDBEGINworkQ: WorkQueue;mark1, mark2, mark3, mark4: ShowTime.Microseconds; -- for benchmark timingPutDigit: SAFE PROCEDURE [c: CHAR] RETURNS [BOOL] = TRUSTEDBEGIN out.PutChar[c]; RETURN [FALSE]; END;mark1 _ ShowTime.GetMark[];z _ Heap.CreateMDS[initial: 2];[in, out] _ UserExec.GetStreams[exec];  -- exec is an ExecHandle, a parameter to Mainout.Put[IO.string["Bench mark starting\n"]];InitTrace[];InitScheduler[];CreateIdler[idler, 0, noWork, running];workQ _ CreatePacket[noWork, worker, workPacketKind];workQ _ CreatePacket[workQ, worker, workPacketKind];CreateWorker[worker, 1000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];workQ _ CreatePacket[workQ, deviceA, devicePacketKind];CreateHandler[handlerA, 2000, workQ, waitingWithPacket];workQ _ CreatePacket[noWork, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];workQ _ CreatePacket[workQ, deviceB, devicePacketKind];CreateHandler[handlerB, 3000, workQ, waitingWithPacket];CreateDevice[deviceA, 4000, noWork, waiting];CreateDevice[deviceB, 5000, noWork, waiting];out.Put[IO.string["Starting\n"]];mark2 _ ShowTime.GetMark[];Schedule[];mark3 _ ShowTime.GetMark[];out.Put[IO.string["Finished\n"]];out.PutF["QueuePacket count = %g, HoldCount = %g\nThese results are ", IO.card[queuePacketCount], IO.card[holdCount]];IF (queuePacketCount = 23246) AND (holdCount = 9297) THEN out.Put[IO.string["correct"]]ELSE out.Put[IO.string["wrong"]];out.Put[IO.string["\nEnd of run\n"]];mark4 _ ShowTime.GetMark[];out.Put[IO.string["***** Scheduler time = "]];ShowTime.ShowDelta[mark3 - mark2, PutDigit];out.Put[IO.string[", Total time = "]];ShowTime.ShowDelta[mark4 - mark1, PutDigit];Heap.DeleteMDS[z];END;UserExec.RegisterCommand["BenchMark", Main];END... ␀␀␀Z␀␀BenchMark.mesa (originally from University of Cambridge)Last Edited by: DCraft, September 13, 1983 12:45 pmMARTIN RICHARDS' BENCHMARK PROGRAM transcribed from BCPLvia Modula version by Peter Robinson of Fri May 20 14:55:00 1983via Mesa version by Jon Gibbons of Aug 5, 1983 22:41into Cedar version by Dan Craft on Sept 9, 1983Dr. Martin Richards of the Computer Laboratory, University of Cambridge, England has written a benchmark program for examining the performance of language/compiler/machine combinations in executing systems software.  The program emulates the action of a small ("Tripos" like) operating system in scheduling and executing six tasks: two devices, two device handlers, a working task, and an idle task.  The input device is driven by a pseudo-random stream of numbers, and the program terminates after a given amount of data has been processed.  The total time taken to execute the program, and the resulting code size are measured.The program was originally written in BCPL, and was intended as a measure not only of a machine's performance, but also of the quality of its BCPL implementation.  Unfortunately, the only specification of the benchmark is the BCPL source code, thus restricting the implementation approach which might be taken with other languages.  The benchmark has now been transcribed into a number of different languages, giving useful comparisons between their efficiency for systems programming.Last Edited by: Mitchell, September 13, 1983 11:34 pmTracer  (doesn't appear to be called, will check if part of original BCPL - DHC)TaskNamesTask Scheduler    WriteF2["currentTask = %N state = %N*N", currentTask.identity, currentTask.state]Idle TaskDevice TaskHandler TaskWorker Task␀JQ␀␀␀J88J3J␀J88J@@JOc44J//J␀JuJ␀JeJ5J␀Ok		J	'aJ	,:J-=J"JJ␀J␀On	
