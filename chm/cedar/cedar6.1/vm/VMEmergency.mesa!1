    DIRECTORY
        PrincOps USING [PageNumber];

    VMEmergency: DEFINITIONS
    = BEGIN

    EmergencyList: TYPE = LONG POINTER TO EmergencyListRep;
    EmergencyListRep: TYPE = RECORD [
        change: INT _ 0,
        max: EmergencyPageRange _ 0,
        pages: ARRAY EmergencyPageRange OF PrincOps.PageNumber
        ];

    EmergencyPageRange: TYPE = [0..64];

    emergencyList: PUBLIC EmergencyList;

    END.
