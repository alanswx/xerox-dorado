//  DoradoProms.defs		last updated January 17, 1978//  Run BLDR with "BLDR/F D1proms MemProms" external  //proceedures d1proms.bcpl	[ Header; PromCommand; StEq ]external  //system proceedures 	[ Zero; MoveBlock ]external  //program statics 	[ ICtype ]manifest	[	DoAll = 0	MC10139 = 1	MC10149 = 2	N74288 = 3	I3601 = 4	LastType = I3601	]structure str[ length byte; char ^ 1,256 byte ]structure MCM149[ Pin15 bit; Pin14 bit; Pin12 bit; Pin11 bit; blank bit 12 ]