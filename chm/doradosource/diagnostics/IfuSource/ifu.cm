//   construct new version of the ifu test code entirely from sources.//  June 18, 1981  9:31 AM@ifuSave.cm@     //   construct definitions file@ifuMemSubrsC.cm@  // construct ifuMemSubrsC.dib from memSubrsC.mc@ifuMemSubrsX.cm@  // construct ifuMemSubrsX.dib from memSubrsX.mc@ifuSubrs.cm@  // construct subroutines that support Ifu code in general.@ifuChaosSubrs.cm@  // construct subroutines that support Ifu chaos code.@ifuRamSubrs.cm@  // construct subroutines that support writing values into IFUM.@ifuStepSubrs.cm@  // construct subroutines that support IfuTest register@ifuTestSubrs.cm@  // construct subroutines in general support of ifu main tests@ifuSimpleOnly.cm@@ifuComplexOnly.cm@@ifu1.cm@     //  construct ifu1@ifu2.cm@    //  construct ifu2@ifu3a.cm@    //  construct ifu3a@ifu3b.cm@    //  construct ifu3b@ifu3c.cm@    //  construct ifu3c//@ifuPlace.cm@ //  placed the ifu diagnostics. Type i*er i*dls to check results@ifuSimplePlace.cm@  // simple ifu diagnostics@ifuComplexPlace.cm@  // complex ifu diagnostics