nitMemTest];	branch[done];initMemTest: subroutine;	RBASE _ rbase[defaultRegion];	rscr _link;	top level;	t _ r0 _ t-t;	rm1 _ cm1;	r1 _ t + 1;	rhigh1 _ 100000C;	r01 _ not(r10);	t _ (r0)+1;	stkp _ t;	ProcSRN_r0;	returnUsing[rscr];* November 29, 1977  10:31 AM* CODE for midas debugging	top level;set[dbgTbls,100];l1: 	branch[l1],	at[dbgTbls,0];l2:	noop,	at[dbgTbls,1];	branch[l2],	at[dbgTbls,2];l3:	noop,	at[dbgTbls,3];	noop,	at[dbgTbls,4];	branch[l3],	at[dbgTbls,5];l4:	noop,	at[dbgTbls,6];	noop,	at[dbgTbls,7];	noop,	at[dbgTbls,10];	branch[l4],	at[dbgTbls,11];l5:	noop,	at[dbgTbls,12];	noop,	at[dbgTbls,13];	noop,	at[dbgTbls,14];	noop,	at[dbgTbls,15];	branch[l5],	at[dbgTbls,16];l6:	noop,	at[dbgTbls,17];	noop,	at[dbgTbls,20];	noop,	at[dbgTbls,21];	noop,	at[dbgTbls,22];	noop,	at[dbgTbls,23];	branch[l6],	at[dbgTbls,24];branch[begin];END;e3\b10B2b18B19b5B202b13B104b10B36b12B291b2B30b2B51b2B73b2B97b2B122b2Be3(0,65535)(1,65535)