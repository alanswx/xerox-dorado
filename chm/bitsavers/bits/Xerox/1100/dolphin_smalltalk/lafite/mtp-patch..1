(DEFINEQ

(EditMTPSenderField
  [LAMBDA (AddressPlist)                         (* edited%: "26-Aug-86 15:41")
        
        (* * This function removes the hostname after the "@" from the 
        SENDER field of an MTP Property List.
        It does so in order to let the VAX Unix SendMail program do it 
        correctly instead.)

    (for x in AddressPlist
       collect (if (EQ (CAR x)
                       'SENDER)
                   then (LIST 'SENDER (LET* [(AddressString (CADR x))
                                             (MatchPos (STRPOS "@" AddressString)
                                                    )
                                             (NewAddressString
                                              (AND MatchPos (SUBSTRING
                                                             AddressString 1
                                                             (SUB1 MatchPos]
                                            (OR NewAddressString AddressString)))
                 else x])

