			+ bfpSize + (sizes at: 3) + (sizes at: 1).
	^(sizes at: 2)
		+ (forValue
				ifTrue: [1]
				ifFalse: [0]) "+1 (push nil) for value only"! !
!MessageNode methodsFor: 'debugger temp access'!isTemp
	"Sorry, folks, for now you cannot use remote temps in blocks. This could
	be fixed by supporting store protocol for the case of assignment into
	virtual fields in BlockNode sizeForValue and emitForValue."

	^false!store: expr from: encoder 
