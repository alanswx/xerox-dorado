					errorInClass: class
					withCode: 
						(sourceStream contents
							copyReplaceFrom: sourceStream position + 1
							to: sourceStream position
							with: aString)]
		ifFalse: [^requestor
					notify: aString
					at: sourceStream position + 1
					in: sourceStream]! !
