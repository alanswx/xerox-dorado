	^(receiver sizeForValue: encoder) 
			+ (self sizeBranch: thenSize) + thenSize + elseSize!sizeWhile: encoder value: forValue 
	"L1: ... Bfp(L2) ... Jmp(L1) L2: nil (nil for value only);
	justStmt, wholeLoop, justJump."

	| cond stmt bfpSize |
	cond _ receiver.
	stmt _ arguments at: 1.
	sizes _ Array new: 3.
	sizes at: 1 put: (stmt sizeForEvaluatedEffect: encoder) + 2.
	selector key == #whileFalse:
		ifTrue: 
			[sizes at: 3 put: (self sizeJump: (sizes at: 1)).
			bfpSize _ self sizeBranch: (sizes at: 3)]
		ifFalse: 
			[sizes at: 3 put: (self sizeBranch: (sizes at: 1)).
			bfpSize _ 0].
