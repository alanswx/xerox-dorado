ExportTracer comment:
'The export tracer clamps out many things, classes, methods, and so on which are not to be part of a system release.'!

!ExportTracer methodsFor: 'initialize-release'!init: ctxt "ExportTracer writeClone."
	"[This version clamps out Mail, Press, and Loom, but not Leaf]."

	| clamped class stats startTime elapsedTime |
	stats _ Disk file: 'Clone.stats'. stats timeStamp.
	startTime _ Time now asSeconds.

	super init: ctxt.
	clamped _ Set new.

	"Clamp entire categories of classes:"
	stats cr; cr; nextPutAll: 'Clamping class categories: '.
	(SystemOrganization categories select:
		[:x | ('Xerox Mail*' match: x) | ('Xerox Printing*' match: x)]) do:
			[:str | stats cr; tab; nextPutAll: str, ': '.
			(SystemOrganization superclassOrder: str) do: 
				[:class | stats print: class; space.
				self clamp: class. clamped add: class]].

	"Clamp individual classes and other globals:"
	stats cr; cr; nextPutAll: 'Clamping individual classes: '; cr; tab.
	#(LoomTracer Phylum "Ether EtherPool IFSLeafFilePool") do:
		[:name | (Smalltalk includesKey: name) ifTrue:
			[class _ Smalltalk at: name. self clamp: class.
			(class isKindOf: Behavior) ifTrue:
				[stats print: class; space.
				clamped add: class]]].

	"Remove Globals:"
	stats cr; cr; nextPutAll: 'Removing globals:'; cr; tab.
	#(Phylum "Ether IFSLeafFilePool EtherPool") do:
		[:global | (Smalltalk includesKey: global) ifTrue:
			[stats print: global; space.
			Smalltalk removeKey: global]].

	"Clamp entire categories of Methods:"
	stats cr; cr; nextPutAll: 'Clamping method categories:'.
	Smalltalk allBehaviorsDo: 
		[:class | 
		(class organization categories select:
			[:x | ('not for*' match: x) | ('press*' match: x)]) do:
				[:name | stats cr; tab; print: class; space; print: name.
				class removeCategory: name].
		class superclass == nil & ((writeDict at: class) ~= #writeClamped:) ifTrue:
			[class == Object ifFalse:
