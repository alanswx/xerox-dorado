	^(FirstDayOfMonth at: monthIndex)
		+ (monthIndex > 2
				ifTrue: [self leap]
				ifFalse: [0])!weekdayIndex
	"Sunday=1, ... , Saturday=7"

	| yearIndex dayIndex |  
	day < (self firstDayOfMonthIndex: 3)
