		ifFalse: ['close'])!release
	self close: nil! !
!IFSLeafFile methodsFor: 'error handling'!errorString: errorIntegerOrString
	"This method takes either an Integer or a String.  This violates the protocol defined in File.  IFSLeafFileDirectory openFile:mode: should be changed to supply an Integer.  [SBP]"

	| ef eName errorCode errorString notFound dollar cr code |
	(errorIntegerOrString isMemberOf: String)
		ifTrue:
			[errorString _ errorIntegerOrString.
			errorCode _ ((errorString at: 1) isDigit
				  		ifTrue: [Integer readFromString: errorString]
				  		ifFalse: [0])]
		ifFalse:
			[errorCode _ errorIntegerOrString.
			errorString _ errorCode printString].

	eName _ '<System>Ifs.Errors'.
	(fileName sameAs: eName) 
	  ifTrue: ["recursion" ^errorString, ' (cannot access Ifs.Errors!!)'].

	notFound _ errorString, ' (error code not found)'.
	errorCode <= 0 ifTrue: [^notFound].
	dollar _ $$.
	cr _ Character cr.
	ef _ fileDirectory oldFile: eName.
	ef readOnly.
	errorString _ nil.

	"scan through the errors file looking for lines of the form:
		$$nn	some message"

	[errorString == nil] whileTrue: 
		[(ef next = dollar and: [ef next = dollar])
		  ifTrue:
			[code _ Integer readFrom: ef.
				code > errorCode
				  ifTrue: ["since errors are ordered" errorString _ notFound]
				  ifFalse:
					[code = errorCode
					  ifTrue:
						[errorString _ WriteStream on: (String new: 200).
						errorCode printOn: errorString.
						[ef peek = dollar or: [ef peek = cr]] 
							whileFalse: 
									[errorString nextPutAll: (ef upTo: cr).
								 errorString nextPut: $ ].
						errorString _ errorString contents]]]
		  ifFalse:
			[ef atEnd ifTrue: ["end of file" errorString _ notFound]]].

	ef close.
	^errorString! !
!IFSLeafFile methodsFor: 'file/page/directory implementation'!doCommand: com page: page error: e 
	"Refer to the comment in File|doCommand:page:error:." | in ecode inpage |
	page command: com.
	[true] whileTrue:
		["make sure connection is open"
		fileDirectory open.
		error _ ''.

		(in _ fileDirectory socket sendPacket: page packet) notNil
		  ifTrue:
			[(in at: 11) = BrokenConnection
			  ifTrue: [ecode _ -1]
			  ifFalse:
				["turn packet into an IFSLeafFilePage"
				inpage _ self pageClass new.
				inpage file: self.
				inpage page: in.
				binary ifTrue: [inpage binary] ifFalse: [inpage text].
				"check if answer is of same type as request"
				((page headerWordAt: 1) bitAnd: RequestBits) + AnswerBit = (
					(inpage headerWordAt: 1) bitAnd: RequestBits)
				  ifTrue: [^inpage].
