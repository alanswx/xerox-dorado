	numberArguments > 4 ifTrue: [^#primitiveFail].
	"currently fails text primitive"
	primitiveMethod _ TryPrimitiveMethods at: numberArguments + 1.
	primitiveMethod 
		literalAt: 2 
		put: ((primitiveMethod literalAt: 2) bitAnd: -256) + primitiveIndex.
