		ifTrue: [1 to: 8 do: 
					[:i | 
					coefficients at: i put: ((coefficients at: i)
											copyFrom: 2 to: length + 1)]]!displayOn: aDisplayMedium at: aPoint clippingBox: clipRect rule: anInteger mask: aForm 
