	self print: 'return: ' , value printString!methodReturnReceiver
	"Print the Return Self bytecode."

	self print: 'returnSelf'!methodReturnTop
	"Print the Return Top Of Stack bytecode."

	self print: 'returnTop'!popIntoLiteralVariable: anAssociation 
	"Print the Remove Top Of Stack And Store Into Literal Variable bytecode."

	self print: 'popIntoLit: ' , anAssociation key!popIntoReceiverVariable: offset 
