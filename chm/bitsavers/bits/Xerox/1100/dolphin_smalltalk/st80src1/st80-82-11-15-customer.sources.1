		[sourceRect _ runX @ lineY extent: (destX - runX - 1) @ textStyle lineGrid.
		destForm
			copyBits: sourceRect from: destForm at: (runX+1) @ lineY
			clippingBox: sourceRect rule: Form under mask: nil]!doesDisplaying
