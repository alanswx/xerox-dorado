!IFSLeafFile methodsFor: 'nonhomogeneous accessing'!read: page 
	"Refer to the comment in File|read:." | |
	page pageNumber > lastPageNumber
	  ifTrue: ["no page" ^nil].

	"don't extend beyond eof. length of page is 0, but request is for 512 bytes"
	page mode: NoExtend.
	page headerWordAt: 5 put: 512 "self dataSize".
	^self doCommand: Read page: page error: 'Read:'!write: page 
	"Refer to the comment in File|write:." | pn |
	(pn _ page pageNumber) > (lastPageNumber + 1)
	  ifTrue: [^self error: 'illegal page number'].
	
	"make sure we can write"
	self writeMode: page.
	page mode: (pn >= lastPageNumber
		ifTrue: [SetEof]
		ifFalse: [NoHoles]).
	self doCommand: Write page: page error: 'Write:'.

	"file possibly extended".
	pn = (lastPageNumber + 1)
		ifTrue: [lastPageNumber _ pn].
	^page! !
!IFSLeafFile methodsFor: 'file accessing'!endFile: page 
	"Refer to the comment in File|endFile:." | |
	"make sure we can write"
	self writeMode: page.

	"update length. this will end file with this page".
	lastPageNumber _ page pageNumber.
	^self write: page! !
