			[supered ifTrue: [self litIndex: (self associationFor: class)]].
	^literalStream contents!tempNames

	| tempNodes |
	tempNodes _ (scopeTable values select: [:node | node isTemp])
		asSortedCollection: [:n1 :n2 | n1 code <= n2 code].
	^tempNodes collect: [:node | node key]! !
!Encoder methodsFor: 'error handling'!notify: string

	| req |
	requestor == nil
		ifFalse: 
			[req _ requestor.
			self release.
			req notify: string].
	^false! !
!Encoder methodsFor: 'source mapping'!noteSourceRange: range forNode: node

	sourceRanges at: node put: range!sourceMap
	"Answer with a sorted set of associations (pc range)."

	| key |
	^(sourceRanges keys collect: 
