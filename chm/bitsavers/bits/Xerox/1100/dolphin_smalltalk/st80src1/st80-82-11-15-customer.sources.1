!Etherworld methodsFor: 'printing'!printOn: s 
	"Refer to the comment in Object|printOn:." 
	EtherState = EthDead
		ifTrue: [s nextPutAll: 'Etherworld, EtherState = EthDead.']
		ifFalse: 
			[s nextPutAll: 'Etherworld running on '.
			s nextPutAll: (NETNUM radix: 8) , '#' , (HOSTNUM radix: 8) , '#; '.
			s nextPutAll: 'EtherState = '.
