				[Transcript cr; show: 'SocketTable: '.
				SocketTable keysDo:
					[:i | Transcript show: (i radix: 8), ', '; print: (SocketTable at: i)]].
		Transcript cr]! !
!Etherworld methodsFor: 'error handling'!error: str 
	"Refer to the comment in Object|error:."
	Transcript cr; show: str; cr!notify: strng
	"Turn off the Ethernet before doing a self error"

	self etherStop.
