			save quit).



	"ScreenController initialize.

	ScreenController allInstancesDo: [:c | c initializeYellowButtonMenu]"! !





!ScreenController methodsFor: 'menu messages'!



openSystemWorkspace

	"Create and schedule a StandardSystemView for use as the System Workspace."



	StringHolderView openSystemWorkspace!



quit

	"Close files then exit to another operating system on the host machine, if

	one exists. All state changes in the object space since the last snapshot

	are lost."



	| menu index imagePrefix |

	menu _ PopUpMenu

		labels: 

' Save, then quit 

 Quit, without saving 

 Continue '

		lines: #(1 2).

	index _ menu startUp.

	index = 1 ifTrue: [Smalltalk saveAs: Smalltalk getImagePrefix thenQuit: true].

	index = 2 ifTrue: [Smalltalk quit]!



save

	"Save the current state of the object space on an external file whose name

	is specified by the user."



	Smalltalk saveAs: Smalltalk getImagePrefix thenQuit: false! !





