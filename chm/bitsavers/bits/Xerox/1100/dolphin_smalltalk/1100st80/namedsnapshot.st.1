initialize

	"Initialize the System Menu."



	ScreenYellowButtonMenu _

		PopUpMenu

			labels:

'restore display

exit project

open project

open browser

open file list

open transcript

open workspace

system workspace

save

quit'

			lines: #(2 8 ).

	ScreenYellowButtonMessages _

			#(restoreDisplay exitProject

