FileInChecker class
	instanceVariableNames: ''!

!FileInChecker class methodsFor: 'initialize-release'!

initialize

	self checkAgainstSystem: false! !

!FileInChecker class methodsFor: 'instance creation'!

new
	"Answer a new instance of me."

	^super new initialize! !

!FileInChecker class methodsFor: 'default instance'!

checkAgainstSystem: aBoolean

	CheckAgainstSystem _ aBoolean!

default
	"Answer a default instance of me"

	DefaultChecker == nil ifTrue: [DefaultChecker _ self new].
	^DefaultChecker!

defaultInstance: aFileInChecker
	"Reset the default instance."

	^DefaultChecker _ aFileInChecker! !

!FileInChecker class methodsFor: 'examples'!

example
	"To see if a set of file-ins conflict:

		FileInChecker default initialize.
		(FileStream oldFileNamed: 'goodie1.st') checkFileIn.
		(FileStream oldFileNamed: 'goodie2.st') checkFileIn.
		(FileStream oldFileNamed: 'goodie3.st') checkFileIn.
		FileInChecker default reportConflictsOn: (FileStream fileNamed: 'conflicts.text').

	----------

	To initialize the checker with an existing ChangeSet:

		FileInChecker default initialize.
		FileInChecker default initialChangeSet: Smalltalk changes.
		(FileStream oldFileNamed: 'goodie1.st') checkFileIn.
		...etc...

	----------

	To initialize the checker with an arbitrary list of changes:

		FileInChecker default initialize.
		FileInChecker default initialChanges:
			#('MyClass initialize' 'MyClass printOn:' 'MyClass class new' 'FileInChecker initialize').
		(FileStream oldFileNamed: 'goodie1.st') checkFileIn.
		...etc..."! !

FileInChecker initialize!


!ReadWriteStream methodsFor: 'fileIn/Out'!

checkFileIn
	"Parse the file to look for definitions which conflict with other changes.
	Use the default FileInChecker."

	^self checkFileIn: FileInChecker default!

checkFileIn: checker 
	"Parse the file to look for definitions which conflict with other changes."

	self readOnly.
	Cursor execute showWhile:
		[[self atEnd]
			whileFalse: 
				[self skipSeparators.
				(self peekFor: $!!)
					ifTrue: [checker
							checkCategory: self nextChunk
							scanFrom: self]
					ifFalse: [checker
							checkDoIt: self nextChunk
							streamIs: self]].
		self close].
	^checker! !
