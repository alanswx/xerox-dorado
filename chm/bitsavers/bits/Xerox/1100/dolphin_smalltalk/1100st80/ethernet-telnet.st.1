TelnetSocket class
	instanceVariableNames: ''!

!TelnetSocket class methodsFor: 'initialization'!

initialize

	DataMarkType _ 1.
	TimingMarkType _ 5.
	TimingMarkReplyType _ 6! !

TelnetSocket initialize!


TextCollectorController subclass: #ChatController
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ethernet-Telnet'!

!ChatController methodsFor: 'control defaults'!

controlActivity
	"Send keyboard characters to my model (a TelnetSocket)."

	| characterStream |
	Sensor keyboardPressed
		ifTrue: 
			[characterStream _ WriteStream on: (String new: 20).
			[Sensor keyboardPressed]
				whileTrue: [characterStream nextPut: Sensor keyboard].
			model sendSmallString: characterStream contents]! !


TextCollector subclass: #Chatter
	instanceVariableNames: 'telnetSocket '
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ethernet-Telnet'!

!Chatter methodsFor: 'socket messages'!

endChat
	"Close connection and socket."

	telnetSocket endChat.
	telnetSocket _ nil!

sendSmallString: aString
	"pass this on to the socket."

	telnetSocket sendSmallString: aString! !

!Chatter methodsFor: 'private'!

characterLimit

	^5000!

telnetSocket: aTelnetSocket

	telnetSocket _ aTelnetSocket! !
"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!

Chatter class
	instanceVariableNames: ''!

!Chatter class methodsFor: 'instance creation'!

chatTo: hostName
	"Open a Chat connection and schedule a ChatView for it."

	| telnetSocket chatter  |
	chatter _ self new.
	telnetSocket _ TelnetSocket new.
	(telnetSocket chatTo: hostName displayIn: chatter) ifFalse:
		[^self notify: 'failed to connect to ', hostName].
	chatter telnetSocket: telnetSocket. 	"note circularity here"
	ChatView open: chatter label: hostName! !

!Chatter class methodsFor: 'examples'!

example
	"How to open a Chat connection."

	Chatter chatTo: 'Maxc'! !


TextCollectorView subclass: #ChatView
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ethernet-Telnet'!

!ChatView methodsFor: 'initialize-release'!

release
	"Intercepted to close the telnet socket -- kludge."
	
	model endChat. 	"note this is wrong if other view/controllers exist"
	super release! !

!ChatView methodsFor: 'controller access'!

defaultControllerClass
	^ChatController! !
