ByteStreamSocket subclass: #TelnetSocket
	instanceVariableNames: 'displayProcess textCollector '
	classVariableNames: 'DataMarkType TimingMarkReplyType TimingMarkType '
	poolDictionaries: ''
	category: 'Ethernet-Telnet'!

TelnetSocket comment:
'A socket that implements Chat-type connections'!

!TelnetSocket methodsFor: 'chatting'!

chatDisplay
	"This is the displaying process for Chat."

	| token |
	[true]
		whileTrue: 
			[token _ self processNextDataPacket.
			(token isMemberOf: MarkByte)
				ifTrue: [self processCommand: token]
				ifFalse: 
					["note no interlock on Transcripts"
					textCollector nextPutAll: token.
					textCollector endEntry]]!

chatTo: hostName displayIn: aChatter

	| nameUser addressBlock |
	textCollector _ aChatter.
	nameUser _ NameUser new.
	addressBlock _ nameUser getAddressBlock: hostName, '+TELNET'.
	addressBlock isNil ifTrue: 	"maybe name includes socket already (e.g. Ernestine)"
		[addressBlock _ nameUser getAddressBlock: hostName].
	nameUser close.
	addressBlock isNil ifTrue: [^false].
	(self openToNet: (addressBlock at: 1)
		Host: (addressBlock at: 2)
		Socket: (addressBlock doubleWordAt: 3)) = 'open'
			ifTrue:	[textCollector cr; show: 'Connected to ', hostName; cr.
						self startChatProcess.
						^true].
	self close.
	textCollector cr.
	textCollector show: 'Can''t connect to ', hostName.
	^false!

endChat

	displayProcess terminate.
	textCollector show: 'Connection Terminated'.
	self close!

startChatProcess

	displayProcess _ [self chatDisplay] newProcess.
	displayProcess priority: Processor userInterruptPriority.
	displayProcess resume! !

!TelnetSocket methodsFor: 'processing input'!

processCommand: commando

	| type |
	(type _ commando type) = CadaverType
		ifTrue:	[self endChat]
		ifFalse:	[type = TimingMarkType ifTrue: [self processTimingMark]]!

processInterrupt: pac
	"Eat bytes until the data mark, processing commands along the way.
	Do nothing because we have already eaten the DM."!

processTimingMark

	self sendMark: TimingMarkReplyType! !

!TelnetSocket methodsFor: 'private'!

markName: byte

	^(byte between: 1 and: 6)
		ifTrue:	[#('[Data-Mark]' '[Line-Width]' '[Page-Length]' '[Terminal-Type]'
						'[Timing-Mark]' '[Timing-Mark-Reply]') at: byte]
		ifFalse:	['']! !
