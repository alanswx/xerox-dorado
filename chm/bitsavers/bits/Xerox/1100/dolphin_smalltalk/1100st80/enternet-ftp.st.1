Dictionary variableSubclass: #PropertyList
	instanceVariableNames: ''
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Ethernet-FTP'!

PropertyList comment:
'A PropertyList is exactly like a Dictionary except it expects its keys to be Strings and it ignores case when comparing keys. Reading and printing using property list syntax is provided. Used by FileTransferSocket for communicating with FTP servers.'!

!PropertyList methodsFor: 'converting'!

addPropertyFrom: aStream

	| property value |
	aStream peekFor: $(.
	property _ aStream upTo: Character space.
	value _ aStream upTo: $).
	^self at: property put: value! !

!PropertyList methodsFor: 'printing'!

printOn: aStream
	"Print in the syntax of a property list."

	aStream nextPut: $(.
	self associationsDo:
		[:assoc |
		aStream nextPut: $(.
		aStream nextPutAll: assoc key.
		aStream space.
		aStream nextPutAll: assoc value.
		aStream nextPut: $)].
	aStream nextPut: $).! !

!PropertyList methodsFor: 'private'!

findKeyOrNil: key 
	"Intercept to cause keys to hash independent of case."

	| location length probe pass |
	length _ self basicSize.
	pass _ 1.
	location _ key asLowercase hash \\ length + 1.
	[(probe _ self basicAt: location) == nil or: [probe key sameAs: key]]
		whileFalse: 
			[(location _ location + 1) > length
				ifTrue: 
					[location _ 1.
					pass _ pass + 1.
					pass > 2 ifTrue: [^self grow findKeyOrNil: key]]].
	^location! !
