!FileList methodsFor: 'accessing'!

filesMatching: pattern
	"Answer a list of file names matching the pattern string. Do this
	by asking the appropriate directory. For IFS files, include the IFS
	name in brackets and strip off the version numbers unless the pattern
	contains a $!!."

	| dir nameBody matches terminator |
	dir _ FileDirectory directoryFromName: pattern setFileName: [:nameBody].
	matches _ dir filesMatching: nameBody.
	dir == Disk
		ifTrue:	[^matches]
		ifFalse:	[terminator _ $!!.
					(pattern includes: terminator) ifTrue: [terminator _ nil].
					^matches collect:
						[:name | '[', dir directoryName, ']', name copyUpTo: terminator]]!

newListAndPattern: aString
	"The argument, aString, consists of file names and file name patterns
	separated by carriage returns. (Patterns include the character $*.)
	Make my new list be those file names, and those files on my directory
	whose names match the patterns. Pattern matching currently assumes
	local disk directory."

	| testPattern readStream newList |
	Cursor execute showWhile:
		[readStream _ ReadStream on: aString.
		newList _ SortedCollection new.
		[readStream atEnd] whileFalse:
			[testPattern _ readStream upTo: Character cr. "get next name/pattern"
			(testPattern includes: $*)
				ifTrue:	[newList addAll: (self filesMatching: testPattern)]
				ifFalse:	[newList add: testPattern]].
		list _ newList.
		listIndex _ 0.
		contents _ ''.
		self changed: #list]! !

