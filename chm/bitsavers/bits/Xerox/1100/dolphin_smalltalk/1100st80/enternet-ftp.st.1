!IFSLeafFileDirectory methodsFor: 'file accessing'!

filesMatching: pattern
	"Open an FTP connection to do this. Answer a collection of file names."

	| ftp propertyList matches |
	[(ftp _ self openFTPConnection) isNil] whileTrue:
		[self notify: 'unable to open connection to ', directoryName, ' - proceed to try again'].
	propertyList _ self propertyList.
	propertyList at: 'name-body' put: pattern.
	propertyList at: 'desired-property' put: 'server-filename'.
		"default is highest versions only"
	(pattern includes: $!!) ifFalse: [propertyList at: 'version' put: 'H'].
	matches _ ftp enumerate: propertyList printString.
	ftp close.
	matches isNil ifTrue: [^self notify: ftp errorMessage].
	^matches collect: [:propList | propList at: 'server-filename']!

oldFileName: oldName rename: newName 
	"Open an FTP connection to do this."

	| ftp propertyList result |
	ftp _ self openFTPConnection.
	propertyList _ self propertyList.
	propertyList at: 'name-body' put: oldName.
	result _ ftp renameFrom: propertyList printString to: '((name-body ', newName, '))'.
	ftp close.
	result ifFalse: [^self notify: ftp errorMessage]!

rename: aFile newName: newName 
	"Note this won't work if the IFS thinks this file is open."

	self oldFileName: aFile fileName rename: newName.
	aFile fileName: newName! !

!IFSLeafFileDirectory methodsFor: 'FTP connection'!

openFTPConnection
	"Answer an open FileTransferSocket to the receiver's host, or nil."

	| ftp |
	ftp _ FileTransferSocket new.
	(ftp createConnectionTo: directoryName)
		ifTrue:	[^ftp]
		ifFalse:	[^nil]!

propertyList
	"Answer a PropertyList containing the receiver's directory, user-name,
	user-password, and connect-name and connect-password."

	| propertyList |
	propertyList _ PropertyList new.
	propertyList at: 'user-name' put: userName.
	propertyList at: 'user-password' put: userPassword.
	connectName isEmpty ifFalse:
		[propertyList at: 'connect-name' put: connectName.
		connectPassword isEmpty ifFalse:
			[propertyList at: 'connect-password' put: connectPassword]].
	^propertyList! !
