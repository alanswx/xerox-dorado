FileTransferSocket class
	instanceVariableNames: ''!

!FileTransferSocket class methodsFor: 'initialization'!

initialize
	 "Set up the MarkByte types and error codes."

	"MarkByte commands:"
	Retrieve _ 1.
	Store _ 2.
	Yes _ 3.
	No _ 4.
	HereIsFile _ 5.
	EOC _ 6. "End-Of-Command"
	Comment _ 7.
	Version _ 8.
	NewStore _ 9.
	Enumerate _ 10.
	HereIsPropertyList _ 11.
	NewEnumerate _ 12.
	Abort _ 13.
	Delete _ 14.
	Rename _ 15.

	"[No] command error codes:"
	CommandUndefined _ 1.
	FileNotFound _ 64

	"FileTransferSocket initialize"! !

FileTransferSocket initialize!


