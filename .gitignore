# macOS
.DS_Store
._.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts (the C emulator)
dorado/build/
dorado/*.o
dorado/*.a
dorado/*.dSYM/
dorado/build/*

# WebAssembly build output (generated by `make web`; deployed via CI)
dorado/web/

# Local-only reference material
# AltoInfo holds external Alto-emulator source trees and disk images
# (~525 MB). Useful for cross-validation but not part of this project's
# source. Re-download from:
#   https://github.com/livingcomputermuseum/ContrAlto  (ContrAlto v1)
#   https://github.com/joshdersch/Contralto  (ContrAlto v2)
#   https://github.com/brouhaha/salto  (salto C source)
AltoInfo/

# Legacy directory name superseded by DoradoDocs/{manuals,schematics,photos}
# (kept here so an accidental restore from backup doesn't end up tracked)
dorado schematics/

# Per-volume PARC archive scratch
# (we keep chm/ — tests depend on those microcode files; ~12 MB)
chm/.cache/
chm/lisp-archive/
.cache/

# Coverage / scratch
.coverage
.pytest_cache/
__pycache__/
*.log

# Misc tmp
.tmp/
tmp/

# Generated listings (mbdis output redirected to file)
*.dls
*.disasm

# Coverage / profiling
*.gcov
*.gcda
*.gcno
build/coverage/

# Reference clone of the Living Computer Museum IFS (Pup boot server), not part of this project
IFS/

# Temp display snapshots
*.pgm

# Build error logs
err.txt
CedarDisk/*.pdi

# Generated Diablo-on-Trident packs (dsk2trident output; large binaries)
AltoDisks/
chm/diskpacks/*.pack
dorado/testdata/trident-readonly/*.pack
tools/nova-trace-diff/ca-cache/

# External rusty-backup tool clone (built the CedarDisk PDI images; ~9 GB)
tools/rusty-backup/

# External Darkstar clone -- the Xerox Dandelion (8010 / Star / 1108) emulator,
# a nested git repo, ~412 MB.  Not part of this project's source; it is here as
# the reader for the Xerox Pilot 8-inch floppies in
# chm/lisp/release-floppies/InterlispReleaseFloppyImsges.zip (D/IO/FloppyDisk.cs
# mounts .IMD directly) and it ships installed 1108 worlds -- Harmony.img,
# Koto.img, Lyric.img, Medley.img.  Re-clone from:
#   https://github.com/livingcomputermuseum/Darkstar
Darkstar/

# Scratch uncompressed PDI images (the tracked copies are the .pdi.gz in CedarDisk/)
dorado/*.pdi

# Generated corpus name index (regenerate with tools/chm_crc_index.py)
/build/

# Generated CHM atlas inventories (tools/build_chm_atlas_inventory.py) --
# 138 MB each, over GitHub's 100 MB blob limit; they stay local.
docs/chm-atlas/remote-inventory.jsonl
docs/chm-atlas/viewer/remote-inventory.js

# Verilator build output for the generated Dorado RTL
verilog/verilator/obj_dir/
verilog/verilator/obj_proms/
verilog/verilator/obj_alu/
