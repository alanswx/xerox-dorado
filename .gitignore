# macOS
.DS_Store
._.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts (the C emulator)
dorado/build/
dorado/*.o
dorado/*.a
dorado/*.dSYM/
dorado/build/*

# WebAssembly build output (generated by `make web`; deployed via CI)
dorado/web/

# Local-only reference material
# AltoInfo holds external Alto-emulator source trees and disk images
# (~525 MB). Useful for cross-validation but not part of this project's
# source. Re-download from:
#   https://github.com/livingcomputermuseum/ContrAlto  (ContrAlto v1)
#   https://github.com/joshdersch/Contralto  (ContrAlto v2)
#   https://github.com/brouhaha/salto  (salto C source)
AltoInfo/

# Legacy directory name superseded by DoradoDocs/{manuals,schematics,photos}
# (kept here so an accidental restore from backup doesn't end up tracked)
dorado schematics/

# Per-volume PARC archive scratch
# (we keep chm/ — tests depend on those microcode files; ~12 MB)
chm/.cache/
.cache/

# Coverage / scratch
.coverage
.pytest_cache/
__pycache__/
*.log

# Misc tmp
.tmp/
tmp/

# Generated listings (mbdis output redirected to file)
*.dls
*.disasm

# Coverage / profiling
*.gcov
*.gcda
*.gcno
build/coverage/

# Reference clone of the Living Computer Museum IFS (Pup boot server), not part of this project
IFS/

# Temp display snapshots
*.pgm

# Build error logs
err.txt
CedarDisk/*.pdi

# Generated Diablo-on-Trident packs (dsk2trident output; large binaries)
AltoDisks/
chm/diskpacks/*.pack
dorado/testdata/trident-readonly/*.pack
tools/nova-trace-diff/ca-cache/

# External rusty-backup tool clone (built the CedarDisk PDI images; ~9 GB)
tools/rusty-backup/

# Scratch uncompressed PDI images (the tracked copies are the .pdi.gz in CedarDisk/)
dorado/*.pdi
